# Neon Serverless PostgreSQL Connection String
# Get your connection string from https://console.neon.tech
DATABASE_URL="postgresql://neondb_owner:password@ep-sample-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require"

# JWT Secret for Session Cookies (Generate a random 32+ character string)
JWT_SECRET="kakeibo-secure-jwt-secret-key-32-chars-minimum"
